# ── Database ───────────────────────────────────────────────
# Development uses SQLite (file relative to prisma/schema.prisma).
# Production: postgresql://USER:PASSWORD@HOST:5432/pinjes (see README).
DATABASE_URL="file:./dev.db"

# ── App ────────────────────────────────────────────────────
# Public base URL, used for canonical URLs, Open Graph and the CSRF origin check.
APP_URL="http://localhost:3000"

# Directory for uploaded files (kept outside /public, served through
# an authorization-aware route). Relative to the project root.
UPLOAD_DIR="storage/uploads"

# Max upload size in megabytes.
UPLOAD_MAX_MB="5"

# ── Development seed only ─────────────────────────────────
# The seeder refuses to run when NODE_ENV=production.
# Never commit real admin credentials.
SEED_ADMIN_EMAIL="admin@pinjes.local"
SEED_ADMIN_PASSWORD="change-me-locally"
# Password used for all demo customer / store accounts created by the seeder.
SEED_DEMO_PASSWORD="change-me-locally"

# ── Reverse proxy ──────────────────────────────────────────
# Jumlah proxy tepercaya di depan app (Nginx, Cloudflare, Vercel, dll). Dipakai untuk
# membaca IP klien dari X-Forwarded-For (rate limit login dan audit log).
# 1 = satu proxy di depan (umum). 0 = tanpa proxy; header diabaikan dan rate limit
# per-IP tidak membedakan pengguna. Jangan diisi lebih besar dari jumlah proxy sebenarnya.
TRUSTED_PROXY_HOPS="1"

# Rahasia untuk /api/cron/expire-bookings (isi string acak panjang di produksi).
CRON_SECRET=""

# ── Cloud Storage (Opsional - default: local) ───────────────
# "local" (disk server lokal) atau "s3" (Cloudflare R2 / AWS S3 / Supabase Storage)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_ENDPOINT="" # e.g. https://<account_id>.r2.cloudflarestorage.com atau https://s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="" # e.g. https://cdn.pinjes.id atau URL bucket publik

# ── Notifikasi Otomatis (Opsional) ─────────────────────────
# WhatsApp Gateway via Fonnte (https://fonnte.com). Kosongkan untuk mode mock logging.
FONNTE_TOKEN=""

# Email Transaksional via Resend (https://resend.com). Kosongkan untuk mode mock logging.
RESEND_API_KEY=""
EMAIL_FROM="PinjeS <notifikasi@pinjes.id>"
