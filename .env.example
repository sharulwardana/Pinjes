# ── Database ───────────────────────────────────────────────
# Development uses SQLite (file relative to prisma/schema.prisma).
# Production: postgresql://USER:PASSWORD@HOST:5432/rentspace (see README).
DATABASE_URL="file:./dev.db"

# ── App ────────────────────────────────────────────────────
# Public base URL, used for canonical URLs, Open Graph and the CSRF origin check.
APP_URL="http://localhost:3000"

# Directory for uploaded files (kept outside /public, served through
# an authorization-aware route). Relative to the project root.
UPLOAD_DIR="storage/uploads"

# Max upload size in megabytes.
UPLOAD_MAX_MB="5"

# ── Development seed only ─────────────────────────────────
# The seeder refuses to run when NODE_ENV=production.
# Never commit real admin credentials.
SEED_ADMIN_EMAIL="admin@rentspace.local"
SEED_ADMIN_PASSWORD="change-me-locally"
# Password used for all demo customer / store accounts created by the seeder.
SEED_DEMO_PASSWORD="change-me-locally"
